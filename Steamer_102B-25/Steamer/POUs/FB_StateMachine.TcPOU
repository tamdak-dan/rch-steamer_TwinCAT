<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_StateMachine" Id="{c229f4cc-9a87-4d59-a1ae-d17bbe58764f}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_StateMachine
VAR_INPUT
    stFaults    		: ST_Faults;
    stHmiSetpoints 		: ST_HmiSetpoints;
	stProcessValues		: ST_ProcessValues;
	bFillComplete		: BOOL;
	bPurgeComplete		: BOOL;
	bSpaFlushed			: BOOL;
	bDpReached			: BOOL;
END_VAR
VAR_OUTPUT
	// system state
    eState           : E_SystemState := E_SystemState.InitController;
    // enable flags for downstream FBs
	eWaterFillMode 	 : E_WaterFillMode;   	// water fill mode startup/autofill/idle
	bControlEnable   : BOOL;   				// PID pressure/temp loops may run
    bPurgeEnable     : BOOL;   				// vessel purge sequence active
	bSpaFlushEnable	 : BOOL;				// enable SPA flush sequence
	bSpaFlushReset	 : BOOL;				// reset SPA flush fb
	bDeliveryEnable	 : BOOL;				// enable steam delivery
	bAutofillEnable	 : BOOL := TRUE;		// enable water autofill during running states
	bExtHeaterEnable : BOOL;				// enable external heater
	bDpLoopEnable	 : BOOL := TRUE;		// enable dp loop
	bTempLoopEnable	 : BOOL := TRUE;		// enable temp loop
    bReady           : BOOL;   				// green Ready: in SteamFlowing, in-band, no faults
    bInStartup       : BOOL;   				// TRUE for any Init* state
	bColdStart		 : BOOL;				// true if most recent startup was cold
END_VAR
VAR
    // --- request flags set by methods, cleared when serviced ---
    bReqStart        : BOOL;
    bReqStop         : BOOL;
    bReqMaint        : BOOL;
    bReqExitMaint    : BOOL;
    bReqFault        : BOOL;
    bReqFaultReset   : BOOL;
	bReqDelivery	 : BOOL;
    // --- state entry detection (rising edge of a new state) ---
    eStatePrev       : E_SystemState;
    bEntry           : BOOL;   // TRUE on the first cycle of the current state

	// --- tmrs for ready condition ---
	tmrReadyMake	: TON;
	tmrReadyBreak	: TON;
	tMakeOrBreak	: TIME := T#1M;

	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//=========================== entry-edge detection ============================
bEntry := (eState <> eStatePrev);
eStatePrev := eState;

//=========================== reset on entry detection ========================
IF bEntry THEN	
	// do something
END_IF

//=========================== global fault override ===========================
// A latching fault forces Fault from ANY state except when already resetting.
IF bReqFault AND (eState <> E_SystemState.Fault) THEN
    eState := E_SystemState.Fault;
    bEntry := TRUE;
END_IF
bReqFault := FALSE;

//=========================== default enable flags ============================
// Recomputed every cycle; each state turns on what it needs below.
eWaterFillMode 		:= E_WaterFillMode.Idle;
bControlEnable  	:= FALSE;
bPurgeEnable    	:= FALSE;
bSpaFlushEnable 	:= FALSE;
bSpaFlushReset  	:= FALSE;
bDeliveryEnable 	:= FALSE;
bReady          	:= FALSE;
bInStartup      	:= FALSE;

// reset retained vars
IF eState <> E_SystemState.SteamFlowing THEN RequestDelivery(FALSE); END_IF


//================================ STATE MACHINE ==============================
CASE eState OF

    //--------------------------------------------------------------------
    E_SystemState.InitController:   // S0 : one-shot init, then idle
    //--------------------------------------------------------------------
        IF bEntry THEN
            // TODO: seed thresholds from GVL_Params here if they differ per unit
            ;
        END_IF
        eState := E_SystemState.SesOff;

    //--------------------------------------------------------------------
    E_SystemState.SesOff:           // S70 : SES off, idle / standby
    //--------------------------------------------------------------------
        IF bReqMaint THEN
            eState := E_SystemState.Maintenance;
        ELSIF stFaults.bAnyFault THEN
			bReqFault := TRUE;
		ELSIF bReqStart AND NOT stFaults.bHmiCommLoss THEN
            eState := E_SystemState.CheckIfHot;
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.CheckIfHot:       // S10 : hot-restart shortcut vs cold start
    //--------------------------------------------------------------------
        // SPA warm (TC1 within band) AND steam flow already > x%*RatedFlow -> jump to SteamFlowing.
        // Otherwise cold start -> fill water
        bInStartup := TRUE;
        IF _IsSpaWarm() AND (_FlowPercent() > GVL_SysParameters.rHotRestartFlowPct) THEN
            eState := E_SystemState.SteamFlowing;
			bColdStart := FALSE;
		ELSE
            eState := E_SystemState.FillWater;
			bColdStart := TRUE;
			bSpaFlushReset := TRUE;
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.FillWater:    // S20 : fill water
    //--------------------------------------------------------------------
        bInStartup      := TRUE;
        eWaterFillMode 	:= E_WaterFillMode.StartupFill;

        IF bReqStop THEN
            eState := E_SystemState.SesOff;
        ELSIF stFaults.bAnyFault THEN
            bReqFault := TRUE;  
        ELSIF bFillComplete THEN
			IF GVL_HMI.stHmiSetpoints.bSetPurgeOnStartup THEN 
				eState := E_SystemState.PurgeVessel;
			ELSE 
				eState := E_SystemState.SetDiffPressure; 
			END_IF
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.PurgeVessel:  // S30 : purge vessel
    //--------------------------------------------------------------------
        bInStartup   := TRUE;
        bPurgeEnable := TRUE;
		bControlEnable := TRUE;

		// Blowdown first, refill second
		IF bPurgeComplete THEN
			eWaterFillMode := E_WaterFillMode.StartupFill;   // legacy rung 114
		ELSE
			eWaterFillMode := E_WaterFillMode.Idle;          // legacy rung 103: "do not fill water until purge complete"
		END_IF

        IF bReqStop THEN
            eState := E_SystemState.SesOff;
        ELSIF stFaults.bAnyFault THEN
            bReqFault := TRUE;
        ELSIF bPurgeComplete AND bFillComplete THEN
            eState := E_SystemState.SetDiffPressure;
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.SetDiffPressure: // S40 : establish differential pressure
    //--------------------------------------------------------------------
        bInStartup     := TRUE;
        bControlEnable := TRUE;   // dP PID runs to bring differential up

        IF bReqStop THEN
            eState := E_SystemState.SesOff;
		ELSIF stFaults.bAnyFault THEN
            bReqFault := TRUE;    // legacy DS start-high -> S10
        ELSIF bDpReached THEN
            eState := E_SystemState.InitMain;
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.InitMain:         // S50 : final checks before flow
    //--------------------------------------------------------------------
		IF bEntry THEN
			IF GVL_HMI.stHmiSetpoints.rSetFlow = 0 THEN
				GVL_HMI.stHmiSetpoints.rSetFlow := 10;
			END_IF
		END_IF

		bInStartup     := TRUE;
		bControlEnable := TRUE;
		bSpaFlushEnable := TRUE;
		eWaterFillMode := E_WaterFillMode.RunningAutofill;
	
		IF bReqStop THEN
			eState := E_SystemState.SesOff;
		ELSIF stFaults.bAnyFault THEN
			bReqFault := TRUE;
		ELSIF bSpaFlushed AND _TempsInBand() AND _FlowInBand() THEN
			eState := E_SystemState.SteamFlowing;
		END_IF

    //--------------------------------------------------------------------
    E_SystemState.SteamFlowing:     // S60: normal production
    //--------------------------------------------------------------------
		IF bEntry THEN
			tmrReadyBreak(IN := FALSE);
			tmrReadyMake(IN := FALSE);
		END_IF
	
        bControlEnable := TRUE;
		eWaterFillMode := E_WaterFillMode.RunningAutofill;
        // Ready = producing, no active faults, flow tracking setpoint
        
		tmrReadyBreak(IN := NOT _TempsInBand() OR NOT _FlowInBand(), PT := tMakeOrBreak);
		tmrReadyMake(IN := _TempsInBand() AND _FlowInBand(), PT := tMakeOrBreak);

		IF tmrReadyMake.Q THEN
			bReady := NOT stFaults.bAnyFault;
		ELSE
			bReady := FALSE;
		END_IF
		
		bDeliveryEnable := bReqDelivery AND NOT stFaults.bHmiCommLoss;
				  
        IF bReqStop THEN
            eState := E_SystemState.SesOff;
		ELSIF stFaults.bAnyFault THEN
			bReqFault := TRUE;
        END_IF

    //--------------------------------------------------------------------
    E_SystemState.Maintenance:      // S80 : manual actuation
    //--------------------------------------------------------------------
        // Outputs handled by FB_OutputHandler via HMI overrides; no auto control.
		bControlEnable := NOT stFaults.bHmiCommLoss;
		
		IF bReqExitMaint OR bReqStop THEN
			eState := E_SystemState.SesOff;
		ELSIF stFaults.bAnyFault THEN
			bReqFault := TRUE;
		END_IF

    //--------------------------------------------------------------------
    E_SystemState.Fault:            // S99 : latched fault
    //--------------------------------------------------------------------
        // All auto outputs off. Only an operator reset leaves this state,
        // and only once all latching faults have actually cleared.
        // Operator reset: clear latches, then let the monitor re-evaluate.

		IF bReqFaultReset AND NOT stFaults.bHmiCommLoss THEN
            eState := E_SystemState.InitController;
        END_IF

ELSE
    // Unknown/illegal state -> safe fallback
    eState := E_SystemState.Fault;
END_CASE

//=========================== clear serviced requests =========================
// (bReqFault is cleared at the top of the next cycle after being serviced.)
bReqStart      := FALSE;
bReqStop       := FALSE;
bReqMaint      := FALSE;
bReqExitMaint  := FALSE;
bReqFaultReset := FALSE;]]></ST>
    </Implementation>
    <Method Name="_FlowInBand" Id="{7b34b003-618c-4463-9a96-27a32ac34e28}">
      <Declaration><![CDATA[METHOD PRIVATE _FlowInBand : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[// check if measured flow is within tolerance of setpoint for hot start
_FlowInBand := ABS(stProcessValues.rFlowActual - stHmiSetpoints.rSetFlow) <= (GVL_SysParameters.rFlowDeadbandPct * stHmiSetpoints.rSetFlow);]]></ST>
      </Implementation>
    </Method>
    <Method Name="_FlowPercent" Id="{51f9c619-5222-4c48-a32b-707ad7ce6221}">
      <Declaration><![CDATA[METHOD PRIVATE _FlowPercent : REAL]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF stProcessValues.rFlowRated > 0.0 THEN
    _FlowPercent := 100.0 * stProcessValues.rFlowActual / stProcessValues.rFlowRated;
ELSE
    _FlowPercent := 0.0;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="_IsSpaWarm" Id="{79115b31-84d2-410e-8a34-0a55ab06bbbe}">
      <Declaration><![CDATA[METHOD PRIVATE _IsSpaWarm : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsSpaWarm := (stProcessValues.rTc1Spa >= GVL_SysParameters.rSpaWarmMinimumTemp);  ]]></ST>
      </Implementation>
    </Method>
    <Method Name="_TempsInBand" Id="{d3fe4c13-f97f-4432-8bcd-b18afa8468b0}">
      <Declaration><![CDATA[// TODO: real temperature bands from params (Warmup Temp V1535, Max Temp V1522).
METHOD PRIVATE _TempsInBand : BOOL
VAR
	rTempBand 	: REAL := 5.0;
	bTc1InBand	: BOOL;
	bTc2InBand	: BOOL;
	bTc3InBand	: BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (stProcessValues.rTc1Spa >= GVL_SysParameters.rSpaTempSp - rTempBand) 
	AND (stProcessValues.rTc1Spa <= GVL_SysParameters.rSpaTempSp + rTempBand) THEN
	bTc1InBand := TRUE;
END_IF

IF (stProcessValues.rTc2FlowMeter >= GVL_SysParameters.rFlowMeterTempSp - rTempBand)
    AND (stProcessValues.rTc2FlowMeter <  GVL_SysParameters.rFlowMeterTempSp + rTempBand) THEN
	bTc2InBand := TRUE;
END_IF

IF NOT bExtHeaterEnable
     OR ( (stProcessValues.rTc3External >= GVL_SysParameters.rExtMinReadyTemp)
      AND (stProcessValues.rTc3External <  GVL_SysParameters.rExtHeaterTempSp + rTempBand) ) THEN
	bTc3InBand := TRUE;
END_IF

 
 _TempsInBand := bTc1InBand AND bTc2InBand AND bTc3InBand;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestAutofill" Id="{6c5258b1-f522-4130-955b-c030451e0001}">
      <Declaration><![CDATA[METHOD RequestAutofill : BOOL
VAR_INPUT
	cmd : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd THEN
	bAutofillEnable := TRUE;
ELSE
	bAutofillEnable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestDelivery" Id="{6fe4967a-b56a-4a13-8d75-e001bdba1ada}">
      <Declaration><![CDATA[METHOD RequestDelivery : BOOL
VAR_INPUT
	cmd	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd THEN 
	bReqDelivery := TRUE; 
ELSE 
	bReqDelivery := FALSE; 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestDpLoop" Id="{ca35a8bd-b54f-45e9-b38e-e4247aa3d5e2}">
      <Declaration><![CDATA[METHOD RequestDpLoop : BOOL
VAR_INPUT
	cmd : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd THEN 
	bDpLoopEnable := TRUE; 
ELSE 
	bDpLoopEnable := FALSE; 
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestExitMaint" Id="{d6350887-01b9-4198-9246-356e4bc00618}">
      <Declaration><![CDATA[METHOD RequestExitMaint : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqExitMaint := TRUE;
RequestExitMaint := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestExtHeater" Id="{387c9316-a84c-4b10-8bd9-0b925a89f5ff}">
      <Declaration><![CDATA[METHOD RequestExtHeater : BOOL
VAR_INPUT
	cmd	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd THEN
	bExtHeaterEnable := TRUE;
ELSE
	bExtHeaterEnable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestFault" Id="{a61af9d8-4978-47f2-84b4-896606f3e70c}">
      <Declaration><![CDATA[// Force Fault. Called by MAIN when FB_FaultMonitor latches a fault.
METHOD RequestFault : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqFault := TRUE;
RequestFault := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestFaultReset" Id="{87dbab1b-7fca-4407-aed1-430ea9e709b2}">
      <Declaration><![CDATA[// Operator reset. Only leaves Fault when latching faults have cleared.
METHOD RequestFaultReset : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqFaultReset := TRUE;
RequestFaultReset := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestMaintenance" Id="{44772f76-bcc8-4a70-8395-cccc8d10bb8d}">
      <Declaration><![CDATA[// Enter Maintenance. Honored only from SesOff.
METHOD RequestMaintenance : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqMaint := TRUE;
RequestMaintenance := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStart" Id="{bac3a0e4-aadf-4d2f-b000-40664aac8f98}">
      <Declaration><![CDATA[// SES ON. Honored only from SesOff (checked in the CASE).
METHOD RequestStart : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqStart := TRUE;
RequestStart := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestStop" Id="{1d1b5f77-76a5-45dc-a6eb-c9f10c103138}">
      <Declaration><![CDATA[// SES OFF / abort. Honored from any running or startup state.
METHOD RequestStop : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[bReqStop := TRUE;
RequestStop := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestTempLoop" Id="{79d0886e-4e8a-4fb8-9af6-f62c73b78862}">
      <Declaration><![CDATA[METHOD RequestTempLoop : BOOL
VAR_INPUT
	cmd : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF cmd THEN
	bTempLoopEnable := TRUE;
ELSE
	bTempLoopEnable := FALSE;
END_IF]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>