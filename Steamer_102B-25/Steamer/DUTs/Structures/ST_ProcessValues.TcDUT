<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <DUT Name="ST_ProcessValues" Id="{a1b2c3d4-0002-4a5b-9c8d-e1f200000002}">
    <Declaration><![CDATA[//=============================================================================
// ST_ProcessValues
//-----------------------------------------------------------------------------
// Live process data in ENGINEERING UNITS (Torr, degC, SLM).
// Populated by FB_FlowCalc / analog input scaling, consumed by FB_Hmi,
// FB_FaultMonitor and FB_PressureControl.
// pack_mode 1 so pyads structure_def offsets are byte-exact.
//=============================================================================
{attribute 'pack_mode' := '1'}
TYPE ST_ProcessValues :
STRUCT
    // --- Pressures [Torr] -------------------------------- 
    rPt1Upstream    	: REAL;    			// PT-1 upstream pressure    
    rPt2Downstream  	: REAL;    			// PT-2 downstream pressure  
    //rPt3AtmRef      	: REAL;    			// PT-3 atmospheric reference
    rDiffPressure   	: REAL;    			// PT-1 - PT-2 differential
	rDiffPressureOffset	: REAL;				// pt1-pt2 differential when equalized
	rAtmPressure		: REAL := 760;		// atmospheric pressure - computed

    // --- Temperatures [degC] ------------------------------
    rTc1Spa         	: REAL;    	// TC1 SPA temperature
    rTc2FlowMeter   	: REAL;    	// TC2 flow meter temperature
    rTc3External    	: REAL;    	// TC3 external heater temperature
    rTc4Delivery    	: REAL;    	// TC4 delivery line temperature

    // --- Flow [SLM] ---------------------------------------
    rFlowActual     	: REAL;    			// F3 calculated steam flow     
    rFlowSetpoint   	: REAL;    			// active flow setpoint         
    rFlowRated      	: REAL := 25.0;    	// rated max flow    
	rFlowRatio			: REAL;				// FL_TO_DP23 = F3 / DP23 --> units: SLM per Torr  
	rCondensateFlow		: REAL;				// flow through the small (drain/condensate) orifice         

    // --- Discrete process status --------------------------
    bWaterHigh			: BOOL;		// water at high limit --> high limit switch on
	bWaterFull      	: BOOL;    	// full water level --> center limit switch on, high off
    bWaterLow       	: BOOL;    	// low water level --> low limit switch on, center/high off
    bWaterEmpty     	: BOOL;    	// empty water level --> low limit switch off    
	bPowerFaultSensor 	: BOOL;		// power fault sensor
	bCabinetFloodSensor	: BOOL;		// cabinet flood sensor
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>