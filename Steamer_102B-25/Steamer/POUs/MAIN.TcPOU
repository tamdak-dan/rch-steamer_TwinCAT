<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{f6813ce8-0276-401c-9fea-66add7e7619a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// HMI Variables
	HMI_bRun 	: BOOL;
	HMI_nPT1	: INT;
	
	// function blocks
	fbFaultMonitor 		: FB_FaultMonitor;
	fbFlowCalcs 		: FB_FlowCalcs;
	fbHmi 				: FB_Hmi;
	fbPressureControl 	: FB_PressureControl;
	fbPurge 			: FB_Purge;
	fbStateMachine 		: FB_StateMachine;
	fbWaterFill 		: FB_WaterFill;
	fbOutputHandler		: FB_OutputHandler;
	GVL_Process: INT;
	
	// fbWaterFill
	reqFillVavle				: BOOL;
	bLS1_WaterCenter_Filtered	: BOOL;
	bLS3_WaterEmpty_Filtered	: BOOL;
	
	// fbPurge
	reqDrainValve				: BOOL;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//========================= FB CALLS =====================================

// FAULT CHECK
fbFaultMonitor();

//========================= HMI (publish + consume) =======================
// Run BEFORE the state machine so command pulses are latched this cycle.
// FB_Hmi publishes GVL_HMI.stStatus and clears consumed command bits.
(* fbHmi(eState        := fbStateMachine.eState,
      stProcess     := GVL_Process.stValues,
      stFaults      := fbFaultMonitor.stFaults,
      bReady        := fbStateMachine.bReady,
      arPidOutput   := fbPressureControl.arOutputPct,
      arValveActual := fbOutputs.arValveState,
      stLimits      := stSetpointLimits); *)
	  
//========================= STATE MACHINE =================================
// Consume the one-cycle HMI command pulses, then run the CASE.
IF fbHmi.bCmdSesOn THEN fbStateMachine.RequestStart(); END_IF
IF fbHmi.bCmdSesOff THEN fbStateMachine.RequestStop(); END_IF
IF fbHmi.bCmdEnterMaint THEN fbStateMachine.RequestMaintenance(); END_IF
IF fbHmi.bCmdExitMaint THEN fbStateMachine.RequestExitMaint(); END_IF
IF fbHmi.bCmdFaultReset THEN
    fbFaultMonitor.ResetAll();
    fbStateMachine.RequestFaultReset();
END_IF

// Latch fault -> force state machine into Fault (only auto-clears via reset).
IF fbFaultMonitor.bAnyLatchingFault THEN
    fbStateMachine.RequestFault();
END_IF

fbStateMachine(stProcessValues := ST_ProcessValues,
				stFaults := ST_Faults,
				stHmiSetpoints := ST_HmiSetpoints,
				eState => E_SystemState,
				bControlEnable => ,
				bWaterFillEnable => ,
				bPurgeEnable => ,
				bReady => ,
				bInStartup => );
				
//========================= SUBROUTINES =================================
// Subroutines only run only when the state machine enables them. In Maintenance,
// the enable flags follow the HMI control-loop override toggles.


fbWaterFill(eMode := E_WaterFillMode,
			bCenterSwitch := GVL_IO.biLS1_WaterMidLevel,
			bEmptySwitch := GVL_IO.biLS3_WaterEmpty,
			bAutofillEnable := GVL_HMI.stHmiCommand.bAutofillEnable,
			qFillValve => fbOutputHandler.bWaterFillValve,
			bFillComplete => ST_HmiStatus.bFillComplete,
			bWaterFillFault => GVL_HMI.stHmiStatus.stFaults.bWaterFill,
			bCenterFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterFull,
			bEmptyFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterEmpty);

fbPurge(bEnable :=,
		rUpstreamPress := GVL_IO.aiPT1_UpstreamPressure,
		bEmptyFiltered := fbWaterFill.bEmptyFiltered,
		qDrainValve => reqDrainValve,
		bPurgeComplete => GVL_HMI.stHmiStatus.stProcess.bSpaFlushed,
		bPurgeTimeout => GVL_HMI.stHmiStatus.stFaults.bVesselPurge,
		bInPressureBand =>);
		
(* fbPressureControl(bEnable        := fbStateMachine.bControlEnable,
                  bDpControlOff  := fbHmi.bDpControlOff,
                  bTempControlOff := fbHmi.bTempControlOff,
                  stProcess      := GVL_Process.stValues,
                  stSetpoints    := fbHmi.stSetpoints);*)
				

			   
			   ]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>