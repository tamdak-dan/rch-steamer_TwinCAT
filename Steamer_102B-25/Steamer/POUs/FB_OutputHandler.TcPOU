<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_OutputHandler" Id="{035bd223-4782-4b25-9fd3-97d3ad8a81a2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_OutputHandler
VAR_INPUT
    eState           : E_SystemState;

    // --- automatic sources (intent from control/sequence FBs) ---
    bWaterFillValve	 : BOOL;	// FB_WaterFill request  -> SV4
    bPurgeValve      : BOOL;	// FB_Purge request      -> SV2 during purge
    bDeliveryPermit  : BOOL;	// state machine: SV3 delivery allowed
    bH1Upstream      : BOOL;	// upstream heater
    bH2Purifier      : BOOL;	// spa haeter
    bFmHeater        : BOOL;	// flowmeter heater
    bExtHeater       : BOOL;	// external heater

    // --- maintenance overrides (FALSE outside Maintenance; gated in FB_Hmi) ---
    arValveOverride  : ARRAY[1..4] OF BOOL;   // 1=SV1 2=SV2 3=SV3 4=SV4

    // --- process feedback needed for actuation timing ---
    stProcess        : ST_ProcessValues;
END_VAR
VAR_OUTPUT
    // feedback for HMI (what we actually commanded this cycle)
    arValveState     : ARRAY[1..4] OF BOOL;
    bHeatersOn       : BOOL;
END_VAR
VAR
    // resolved valve commands before interlocks
    bSV1_DrainValve        	: BOOL;
    bSV2_SpaValve          	: BOOL;
    bSV3_DeliveryValve     	: BOOL;
    bSV4_WaterInletValve   	: BOOL;

    // SesOff SV2 pressure relief delayed close
    tonSv2Close      		: TON;

    bRunningState    		: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Convenience: are we in a state that runs process automatically?
bRunningState := (eState = E_SystemState.FillWater)
              OR (eState = E_SystemState.PurgeVessel)
              OR (eState = E_SystemState.SetDiffPressure)
              OR (eState = E_SystemState.InitMain)
              OR (eState = E_SystemState.SteamFlowing);

//============================================================================
// 1. RESOLVE VALVE COMMANDS BY CONTEXT  (all boolean - solenoids are on/off)
//============================================================================
CASE eState OF

    //-- Manual mode: HMI overrides drive the valves directly --------------
    E_SystemState.Maintenance:
        bSV1_DrainValve    		:= arValveOverride[1];
        bSV2_SpaValve      		:= arValveOverride[2];
        bSV3_DeliveryValve 		:= arValveOverride[3];
        bSV4_WaterInletValve    := arValveOverride[4];

    //-- Safe shutdown: SV1/3/4 closed; SV2 pressure-relief then delayed ----
    //   SV2 held open until upstream pressure < 800 Torr
    E_SystemState.SesOff, E_SystemState.InitController, E_SystemState.CheckIfHot, E_SystemState.Fault:
        bSV1_DrainValve    := FALSE;
        bSV3_DeliveryValve := FALSE;
        bSV4_WaterInletValve    := FALSE;
        tonSv2Close(IN := (stProcess.rPt1Upstream < GVL_SysParameters.rUpstreamPressureReleived),
                    PT := GVL_SysParameters.tSv2CloseDelay);
        bSV2_SpaValve := NOT tonSv2Close.Q;   // stay open until relieved+delay

    //-- Running states: automatic intent from sequence FBs ------------------
    ELSE
        tonSv2Close(IN := FALSE);   // keep the relief timer reset while running
		
		// SV1 drain: closed in these states (drain handled via maintenance)
        bSV1_DrainValve := bPurgeValve;

        // SV2 main: open during purge, and held open while steam is flowing
        bSV2_SpaValve := (eState = E_SystemState.SteamFlowing);

        // SV3 process delivery: pure on/off. Legacy Y3 is SET on SES-On and
        // RST on SES-Off / stage exit. Here the state machine supplies the
        // delivery permit; SV3 opens only while flowing and permitted.
        bSV3_DeliveryValve := (eState = E_SystemState.SteamFlowing) AND bDeliveryPermit;

        // Water fill sequence owns SV4
        bSV4_WaterInletValve := bWaterFillValve;

END_CASE

//============================================================================
// 2. HARD INTERLOCKS  (apply AFTER resolution; no state can bypass)
//============================================================================
IF bSV3_DeliveryValve THEN
    bSV1_DrainValve := FALSE;         // no draining during delivery
END_IF
IF bSV1_DrainValve THEN
    bSV2_SpaValve := FALSE;          // isolate main while draining
END_IF

//============================================================================
// 3. RESOLVE HEATERS
//============================================================================
// Heaters run ONLY in running states. In SesOff/Fault/Maint heaters are off
IF NOT bRunningState THEN
    bH1Upstream := FALSE;
    bH2Purifier := FALSE;
    bFmHeater   := FALSE;
    bExtHeater  := FALSE;
END_IF

//============================================================================
// 4. SINGLE WRITE POINT -> physical coils
//============================================================================
GVL_IO.boSV1_DrainValve         := bSV1_DrainValve;
GVL_IO.boSV2_SpaValve           := bSV2_SpaValve;
GVL_IO.boSV3_DeliveryValve      := bSV3_DeliveryValve;
GVL_IO.boSV4_WaterInletValve	:= bSV4_WaterInletValve;

GVL_IO.boH1_UpstreamHeater 		:= bH1Upstream;
GVL_IO.boH2_SpaHeater 			:= bH2Purifier;
GVL_IO.boH3_FlowmeterHeater 	:= bFmHeater;
GVL_IO.boH4_ExternalHeater		:= bExtHeater;

//============================================================================
// 5. FEEDBACK for HMI
//============================================================================
arValveState[1] := bSV1_DrainValve;
arValveState[2] := bSV2_SpaValve;
arValveState[3] := bSV3_DeliveryValve;
arValveState[4] := bSV4_WaterInletValve;
bHeatersOn := bH1Upstream OR bH2Purifier OR bFmHeater OR bExtHeater;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>