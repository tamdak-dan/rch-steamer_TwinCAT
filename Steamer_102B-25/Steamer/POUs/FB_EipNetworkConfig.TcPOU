<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_EipNetworkConfig" Id="{d63751fd-1547-4546-88a8-c18affb969b9}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_EipNetworkConfig
VAR
    fbSdoWrite : FB_EcCoeSdoWriteEx;
    fbSdoRead  : FB_EcCoeSdoReadEx;
    fbState    : FB_EcSetSlaveState;
    tonHold    : TON;
    nStep, nIdx : INT;
    aValues    : ARRAY[1..3] OF UDINT;   // ip, mask, gw in the terminal's byte order
    nTmp       : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[CASE nStep OF
0:  // idle
    IF GVL_HMI.stHmiCommand.bEipApply THEN
        GVL_HMI.stHmiCommand.bEipApply := FALSE;
        IF MAIN.eSystemState = E_SystemState.SesOff THEN                       // same lock as the HMI
            aValues[1] := ToTerminalOrder(GVL_HMI.stHmiSetpoints.stEip.nIp);
            aValues[2] := ToTerminalOrder(GVL_HMI.stHmiSetpoints.stEip.nMask);
            aValues[3] := ToTerminalOrder(GVL_HMI.stHmiSetpoints.stEip.nGateway);
            GVL_HMI.stHmiStatus.stEip.nApplyState := 1;
            nIdx := 1;  nStep := 10;
        END_IF
    END_IF

10: // write 0xF800:21, :22, :23 one at a time
    fbSdoWrite(sNetId := F_CreateAmsNetId(GVL_IO.stEipAdsAddr.netId), nSlaveAddr := GVL_IO.stEipAdsAddr.port,
               nIndex := 16#F800, nSubIndex := INT_TO_BYTE(16#20 + nIdx),
               pSrcBuf := ADR(aValues[nIdx]), cbBufLen := 4, bExecute := TRUE);
    IF NOT fbSdoWrite.bBusy THEN
        fbSdoWrite(bExecute := FALSE);
        IF fbSdoWrite.bError THEN nStep := 90;
        ELSIF nIdx < 3 THEN nIdx := nIdx + 1;
        ELSE nStep := 20; END_IF
    END_IF

20: // PreOp, then back to Op: the terminal takes the new settings on the way to Op
    fbState(sNetId := F_CreateAmsNetId(GVL_IO.stEipAdsAddr.netId), nSlaveAddr := GVL_IO.stEipAdsAddr.port,
            reqState := EC_DEVICE_STATE_PREOP, bExecute := TRUE);
    IF NOT fbState.bBusy THEN
        fbState(bExecute := FALSE);
        IF fbState.bError THEN nStep := 90; ELSE nStep := 30; END_IF
    END_IF

30: fbState(sNetId := F_CreateAmsNetId(GVL_IO.stEipAdsAddr.netId), nSlaveAddr := GVL_IO.stEipAdsAddr.port,
            reqState := EC_DEVICE_STATE_OP, bExecute := TRUE);
    IF NOT fbState.bBusy THEN
        fbState(bExecute := FALSE);
        IF fbState.bError THEN nStep := 90; ELSE nIdx := 1; nStep := 40; END_IF
    END_IF

40: // read the active settings back from 0xF900:21..23 for the HMI
    fbSdoRead(sNetId := F_CreateAmsNetId(GVL_IO.stEipAdsAddr.netId), nSlaveAddr := GVL_IO.stEipAdsAddr.port,
              nIndex := 16#F900, nSubIndex := INT_TO_BYTE(16#20 + nIdx),
              pDstBuf := ADR(nTmp), cbBufLen := 4, bExecute := TRUE);
    IF NOT fbSdoRead.bBusy THEN
        fbSdoRead(bExecute := FALSE);
        IF fbSdoRead.bError THEN nStep := 90; RETURN; END_IF
        CASE nIdx OF
            1: GVL_HMI.stHmiStatus.stEip.nIpActive      := FromTerminalOrder(nTmp);
            2: GVL_HMI.stHmiStatus.stEip.nMaskActive    := FromTerminalOrder(nTmp);
            3: GVL_HMI.stHmiStatus.stEip.nGatewayActive := FromTerminalOrder(nTmp);
        END_CASE
        IF nIdx < 3 THEN nIdx := nIdx + 1;
        ELSE GVL_HMI.stHmiStatus.stEip.nApplyState := 2; nStep := 80; END_IF
    END_IF

80: // hold done (2) or error (3) so the HMI sees it, then back to idle
    tonHold(IN := TRUE, PT := SEL(GVL_HMI.stHmiStatus.stEip.nApplyState = 3, T#3S, T#10S));
    IF tonHold.Q THEN
        tonHold(IN := FALSE);
        GVL_HMI.stHmiStatus.stEip.nApplyState := 0;
        nStep := 0;
    END_IF

90: GVL_HMI.stHmiStatus.stEip.nApplyState := 3;
    nStep := 80;
END_CASE]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>