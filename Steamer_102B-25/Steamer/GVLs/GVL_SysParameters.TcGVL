<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_SysParameters" Id="{410e5bc5-dbe8-44c0-bfab-b5480c733766}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
// ------------------------- persisent vars -----------------------------------
VAR_GLOBAL
	
	// SV2 pressure relief and closing delay
		rUpstreamPressureReleived : REAL := 700;	// 700 Torr
		tSv2CloseDelay 		: TIME := T#5S;
	
	// --- State Machine ------------------------------------------------------
	
	// CheckIfHot state
		rSpaWarmMinimumTemp : REAL := 30.0;		// 30 degC --> TODO: check if this value makes sense
		rHotRestartFlowPct 	: REAL := 10.0;    	// current flow is over x% of rated flow	


	// SteamFlowing State
		rFlowDeadbandPct 	: REAL := 0.10;		// deadband target of steam flow as %

	// ------------------------------------------------------------------------	

	// FB_WaterFill
		tDebounceTimer 			: TIME := T#1S;
		tStartupFillTimeout		: TIME := T#15M;
		tFillConfirmDelay		: TIME := T#5S;
		tAutoFillTimeout		: TIME := T#1M;
		tAutoFillDelay			: TIME := T#10S;	
	
	// FB_Purge
		rAtmosphericPressure	: REAL := 760; 							// [torr] default, calc'd in FB_Purge 
		rPurgeTargetPressure	: REAL := rAtmosphericPressure + 50; 	// [torr]
		rPurgeBand				: REAL := 20; 							// [torr]
		tDrainOpen				: TIME := T#1S;
		tEquilibrate			: TIME := T#5S;
		tPurgeTimeout			: TIME := T#15M;
	
	// FB_PressureControl
		tPidSampleTime			: TIME := T#50MS;
		
		// --- loop 1: boiler / upstream pressure -> H1 ---------------------------
		rPid1_Kp				: REAL := 25.0;		// [%/Torr]
		rPid1_Ti				: REAL := 20.0;		// [s]  legacy = K200 -> 20.0
		rPid1_Td				: REAL := 0.0;		// [s]  legacy = K0
		tPid1PwmPeriod			: TIME := T#2S;		// legacy = K200 (0.01 s units)
		tPid1PwmPeriodSlow		: TIME := T#4S;		// legacy = K400, purge / pre-flush
		tPid1MaxOnTime			: TIME := T#2S;		// legacy = 200 counts. Fixed, so the slow period caps at 50 %.
		rIniDeltaPressure		: REAL := 100.0;	// [Torr] pre-flush SP above PT3
		rPspGainOffset			: REAL := 0.0;		// [Torr] Never initialised in legacy
		tSpRampInterval			: TIME := T#500MS;	// legacy = K5 (0.1 s units)
		rSpRampStep				: REAL := 1.0;		// [Torr] per interval -> 2 Torr/s
	 
		// --- loop 2: SPA / purifier temperature -> H2 ---------------------------
		rPid2_Kp				: REAL := 20.0;		// [%/degC]
		rPid2_Ti				: REAL := 15.0;		// [s]  legacy = K150
		rPid2_Td				: REAL := 0.0;		// [s]  legacy = K50. Consider 0 until loop is characterised
		tPid2PwmPeriod			: TIME := T#100MS;	// legacy = K10
	 
		// --- loop 3: flow meter temperature -> H3 -------------------------------
		rPid3_Kp				: REAL := 2000.0;	// [%/degC]
		rPid3_Ti				: REAL := 15.0;		// [s]
		rPid3_Td				: REAL := 5.0;		// [s]
		tPid5PwmPeriod			: TIME := T#100MS;	// legacy V1530 = K10
		rFlowMeterTempSp		: REAL := 120.0;	// [degC] legacy = K1200
		rDeliveryTempCutout		: REAL := 140.0;	// [degC] legacy = K1400, TC4 at or above this inhibits H3.
	 
		// --- loop 4: external line heater -> H4 (bang-bang) ---------------------
		rExtHeaterTempSp		: REAL := 120.0;	// [degC] legacy V1521 = K1200
	 
		// --- shared temperature limit -------------------------------------------
		rMaxTemp				: REAL := 150.0;	// [degC]
 	
	
	
	
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>