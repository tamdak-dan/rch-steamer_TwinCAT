<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_Faults" Id="{a1b2c3d4-0003-4a5b-9c8d-e1f200000003}">
    <Declaration><![CDATA[//=============================================================================
// ST_Faults
//-----------------------------------------------------------------------------
// One named BOOL per fault, replacing the legacy B1600.x / B1601.x / B1602.x
// bit-of-word addressing. Names taken from the element documentation table
// in the DS6 source. Legacy address noted per field for commissioning.
// pack_mode 1: each BOOL = 1 byte, so pyads can map this with a simple
// structure_def or read it as a byte array.
//=============================================================================
{attribute 'pack_mode' := '1'}
TYPE ST_Faults :
STRUCT
	// --- Legacy system faults --------------------------------------------
    bAnyFault					: BOOL;   	// High when any fault is active
    bPowerFault          		: BOOL;   	// Power fault input high
	bCabinetFlood        		: BOOL;   	// Cabinet flood fault
    bPneumaticLow        		: BOOL;   	// Pneumatic air pressure low
    bUpstreamOverPress   		: BOOL;   	// Upstream over pressure
    bDownstreamOverPress 		: BOOL;   	// Downstream over pressure
    bPt1HardwareFault      		: BOOL;   	// PT1 hardware fault
    bPt2HardwareFault      		: BOOL;   	// PT2 hardware fault
	bSpaOverTemp				: BOOL;		// SPA greater than max temp stpt
	bFlowmeterOverTemp			: BOOL;		// fm greater then max temp stpt
	bExtOverTemp				: BOOL;		// external temp greater than max stpt
	bDownstreamOverTemp			: BOOL;		// delivery temp greater than max stpt
	bSpaWarmupTimeout			: BOOL;		// spa temp below stpt after timeout
	bFlowmeterWarmupTimeout		: BOOL;		// fm temp below stpt after timeout
	bExtWarmupTimeout			: BOOL;		// external temp below stpt after timeout
	bDownstreamWarmupTimeout	: BOOL;		// ds temp below stpt after timeout
	bExtTempDecoupled			: BOOL;		// external temp disconnected from heater
	bExtTempLow					: BOOL;		// external temp low after steam ready
    bWaterEmpty          		: BOOL; 	// empty water level fault
	bWaterFillTimeout          	: BOOL; 	// water not full after timeout 
	bWaterDrainTimeout          : BOOL; 	// water not empty after timeout
	bWaterRegulationFault		: BOOL;		// water PID stuck on too long
	bPurgeTimeout				: BOOL;		// vessel purge incomplete after timeout
	bDownstreamStartOverPress	: BOOL;		// vessel not properly vented before restart
	bStartDpTimeout				: BOOL;		// diff pressure timeout before reaching stpt
	bStartDpHardwareFault		: BOOL;		// pressure outside of allowable variance
	bFlowFault					: BOOL;		// flow to dp ratio exceeds calibrated max

    // --- New-system faults ---------------------------------------
    bHmiCommLoss         : BOOL;   // (new) RPi heartbeat timeout
	
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>