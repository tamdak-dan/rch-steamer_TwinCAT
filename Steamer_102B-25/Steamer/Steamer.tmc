tput</Value></Property></Properties></SubItem><SubItem><Name>rBoilerSpActive</Name><Type>REAL</Type><Comment><![CDATA[ ramped SP fed to PID1]]></Comment><BitSize>32</BitSize><BitOffs>1024</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>bDiffPressReached</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>1056</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>rtrigEnable</Name><Type Namespace="Tc2_Standard">R_TRIG</Type><Comment><![CDATA[ --- edges / gating ----------------------------------------------------]]></Comment><BitSize>64</BitSize><BitOffs>1088</BitOffs></SubItem><SubItem><Name>bPurging</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>1152</BitOffs></SubItem><SubItem><Name>fbSampleTick</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ --- PID sample-rate gate (legacy K5 = 0.05 s) -----------------]]></Comment><BitSize>224</BitSize><BitOffs>1184</BitOffs></SubItem><SubItem><Name>bSample</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>1408</BitOffs></SubItem><SubItem><Name>rDt</Name><Type>REAL</Type><Comment><![CDATA[ [s] sample interval as a real]]></Comment><BitSize>32</BitSize><BitOffs>1440</BitOffs></SubItem><SubItem><Name>fbRampTick</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ --- loop 1 setpoint generation ----------------------------------------]]></Comment><BitSize>224</BitSize><BitOffs>1472</BitOffs></SubItem><SubItem><Name>tPwmPeriod1</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>1696</BitOffs></SubItem><SubItem><Name>rDutyCap1</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>1728</BitOffs></SubItem><SubItem><Name>arIntegral</Name><Type>REAL</Type><ArrayInfo><LBound>1</LBound><Elements>4</Elements></ArrayInfo><Comment><![CDATA[ --- per-loop PID state (index = legacy PID number) --------------------]]></Comment><BitSize>128</BitSize><BitOffs>1760</BitOffs></SubItem><SubItem><Name>arPrevPv</Name><Type>REAL</Type><ArrayInfo><LBound>1</LBound><Elements>4</Elements></ArrayInfo><BitSize>128</BitSize><BitOffs>1888</BitOffs></SubItem><SubItem><Name>arPrimed</Name><Type>BOOL</Type><ArrayInfo><LBound>1</LBound><Elements>4</Elements></ArrayInfo><BitSize>32</BitSize><BitOffs>2016</BitOffs></SubItem><SubItem><Name>arPwmTimer</Name><Type Namespace="Tc2_Standard">TON</Type><ArrayInfo><LBound>1</LBound><Elements>4</Elements></ArrayInfo><Comment><![CDATA[ --- per-loop PWM state -------------------------------------------------]]></Comment><BitSize>896</BitSize><BitOffs>2048</BitOffs></SubItem><SubItem><Name>arPwmDutyLatched</Name><Type>REAL</Type><ArrayInfo><LBound>1</LBound><Elements>4</Elements></ArrayInfo><BitSize>128</BitSize><BitOffs>2944</BitOffs></SubItem><SubItem><Name>i</Name><Type>INT</Type><BitSize>16</BitSize><BitOffs>3072</BitOffs></SubItem><Method><Name>RunPid</Name><Comment><![CDATA[=============================================================================
 RunPid
-----------------------------------------------------------------------------
 Standard (ISA) positional PID, output in percent.

   out = Kp * e  +  (Kp/Ti) * INTEGRAL(e)  -  Kp * Td * d(PV)/dt

 Derivative acts on the MEASUREMENT, not the error, so a setpoint change
 does not produce a derivative spike.

 Anti-windup: the integral accumulator is clamped to the output range. This
 is the same trick as legacy rung 456 ("freeze integral if over"), which
 clamped the PID bias word to the output maximum.

 State lives in the FB's arrays, indexed by nLoop, so one method serves
 every loop. Call at the sample rate only - it uses rDt, not the task cycle.
=============================================================================]]></Comment><ReturnType>REAL</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>nLoop</Name><Comment><![CDATA[ 1..4, index into the state arrays]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>rSp</Name><Comment><![CDATA[ setpoint, engineering units]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rPv</Name><Comment><![CDATA[ process value, same units]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rKp</Name><Comment><![CDATA[ proportional gain [% per engineering unit]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rTi</Name><Comment><![CDATA[ integral / reset time [s]. 0 disables integral action]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rTd</Name><Comment><![CDATA[ derivative / rate time [s]. 0 disables derivative]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rOutMin</Name><Comment><![CDATA[ output floor [%]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rOutMax</Name><Comment><![CDATA[ output ceiling [%]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rDt</Name><Comment><![CDATA[ sample interval [s]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Local><Name>rError</Name><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rProp</Name><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rDeriv</Name><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rOut</Name><Type>REAL</Type><BitSize>32</BitSize></Local></Method><Method><Name>_TargetDiffPressure</Name><ReturnType>REAL</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>rFlowSp</Name><Comment><![CDATA[ set flow rate]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Local><Name>rQtotal</Name><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rOrificeA1</Name><Comment><![CDATA[ main orifice coefficient]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rOrificeB1</Name><Comment><![CDATA[ main orifice offset]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Local><Local><Name>rPtMinTorr</Name><Comment><![CDATA[ minimum torr to enable calculated flow]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Local></Method><Method><Name>ResetLoop</Name><Comment><![CDATA[=============================================================================
 ResetLoop
-----------------------------------------------------------------------------
 Clears every piece of memory belonging to one loop: integral accumulator,
 derivative history, PWM timer and latched duty, published output.
 Called when the loop is disabled so a re-enable never inherits wind-up or
 a stale pulse width.
=============================================================================]]></Comment><Parameter><Name>nLoop</Name><Type>INT</Type><BitSize>16</BitSize></Parameter></Method><Method><Name>RunPwm</Name><Comment><![CDATA[=============================================================================
 RunPwm
-----------------------------------------------------------------------------
 Time-proportioned output: turns a 0..100 % demand into a digital heater
 command with a fixed period. 

 The demand is LATCHED at each period boundary. Without this the
 on-time would move underneath an in-progress pulse.

 Must be called EVERY task cycle - the period timer only advances when it
 is called. Resolution is one task cycle (10 ms), so a 2 s period gives
 0.5 % granularity.
=============================================================================]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>nLoop</Name><Comment><![CDATA[ 1..4, index into the timer array]]></Comment><Type>INT</Type><BitSize>16</BitSize></Parameter><Parameter><Name>rDutyPct</Name><Comment><![CDATA[ demand 0..100 %]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>tPeriod</Name><Comment><![CDATA[ PWM period]]></Comment><Type>TIME</Type><BitSize>32</BitSize></Parameter><Local><Name>nPeriodMs</Name><Type>UDINT</Type><BitSize>32</BitSize></Local><Local><Name>nOnMs</Name><Type>UDINT</Type><BitSize>32</BitSize></Local><Local><Name>rDuty</Name><Type>REAL</Type><BitSize>32</BitSize></Local></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_Purge</Name><Comment><![CDATA[=============================================================================
 FB_Purge | VERIFIED 8.2.26 DA
-----------------------------------------------------------------------------

 MECHANISM - it is a repeating DRAIN / EQUILIBRATE cycle, not a one-shot:
   * A pressure band is built around the target setpoint:
       upper = TSP + band 
       lower = TSP - band 
   * Purge only proceeds while upstream pressure is inside that band.
   * Cycle, gated by "OK to purge" latch:
       1. Open drain valve SV1 for tDrainOpen 
       2. Close SV1, wait tEquilibrate to let water settle and for the boiler
			pressuer loop to raise the upstream pressure to within the range
       3. If the EMPTY switch (LS3) now reads empty -> purge complete.
          Otherwise, if still in band, re-open SV1 and repeat.
   * Overall watchdog: if the cycle runs longer than tPurgeTimeout -> bPurgeFault
   * After complete: water fill is allowed and the state machine advances
     to SetDiffPressure

 Reports intent only:
   qDrainValve -> FB_OutputHandler -> GVL_IO.qxSv1Drain (single writer).
   bPurgeComplete -> FB_StateMachine (S11 -> S13 transition).
   bPurgeTimeout  -> FB_FaultMonitor (latches the fault, like every other).
=============================================================================]]></Comment><BitSize>896</BitSize><SubItem><Name>bEnable</Name><Type>BOOL</Type><Comment><![CDATA[ TRUE while state = PurgeVessel]]></Comment><BitSize>8</BitSize><BitOffs>32</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>rUpstreamPress</Name><Type>REAL</Type><Comment><![CDATA[ upstream pressure [Torr]]]></Comment><BitSize>32</BitSize><BitOffs>64</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>bEmptyFiltered</Name><Type>BOOL</Type><Comment><![CDATA[ filtered LS3 empty switch]]></Comment><BitSize>8</BitSize><BitOffs>96</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>qDrainValve</Name><Type>BOOL</Type><Comment><![CDATA[ -> FB_OutputHandler -> SV1 drain]]></Comment><BitSize>8</BitSize><BitOffs>104</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>bPurgeComplete</Name><Type>BOOL</Type><Comment><![CDATA[ -> state machine]]></Comment><BitSize>8</BitSize><BitOffs>112</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>bPurgeTimeout</Name><Type>BOOL</Type><Comment><![CDATA[ -> FaultMonitor Momentary report]]></Comment><BitSize>8</BitSize><BitOffs>120</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>bInPressureBand</Name><Type>BOOL</Type><Comment><![CDATA[ diagnostic: pressure within purge band]]></Comment><BitSize>8</BitSize><BitOffs>128</BitOffs><Properties><Property><Name>ItemType</Name><Value>Output</Value></Property></Properties></SubItem><SubItem><Name>bOkToPurge</Name><Type>BOOL</Type><Comment><![CDATA[ "OK to purge" drain-phase latch]]></Comment><BitSize>8</BitSize><BitOffs>136</BitOffs></SubItem><SubItem><Name>bTimeoutRetryUsed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>144</BitOffs></SubItem><SubItem><Name>rPressureBandUpper</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>160</BitOffs></SubItem><SubItem><Name>rPressureBandLower</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>192</BitOffs></SubItem><SubItem><Name>tonDrainOpen</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ valve-open dwell]]></Comment><BitSize>224</BitSize><BitOffs>224</BitOffs></SubItem><SubItem><Name>tonEquilibrate</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ valve-closed settle]]></Comment><BitSize>224</BitSize><BitOffs>448</BitOffs></SubItem><SubItem><Name>tonPurgeTimeout</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ overall watchdog]]></Comment><BitSize>224</BitSize><BitOffs>672</BitOffs></SubItem><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_SpaFlush</Name><BitSize>512</BitSize><SubItem><Name>bEnable</Name><Type>BOOL</Type><Comment><![CDATA[ TRUE while in SteamPrecheck]]></Comment><BitSize>8</BitSize><BitOffs>32</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>bReset</Name><Type>BOOL</Type><Comment><![CDATA[ clear counter + completion]]></Comment><BitSize>8</BitSize><BitOffs>40</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>rUpstreamPress</Name><Type>REAL</Type><Comment><![CDATA[ PT1 [Torr]]]></Comment><BitSize>32</BitSize><BitOffs>64</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>rAtmPressure</Name><Type>REAL</Type><Comment><![CDATA[ crossing threshold [Torr] ]]></Comment><BitSize>32</BitSize><BitOffs>96</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Prope