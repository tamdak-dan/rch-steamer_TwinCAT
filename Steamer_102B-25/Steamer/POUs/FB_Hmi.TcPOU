<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="FB_Hmi" Id="{8f208da5-e654-4ab9-8425-89789dddd507}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Hmi
VAR_INPUT
	eState          		: E_SystemState;
    stProcess       		: ST_ProcessValues;
    stFaults        		: ST_Faults;              // from FB_FaultMonitor
    bReady          		: BOOL;                   // temps in band, ok to flow
	
    // arPidOutput     : ARRAY[1..6] OF REAL;    // loop outputs 0..100 %
    // arValveActual   : ARRAY[1..4] OF BOOL;    // real valve output states
    // stLimits        : ST_SetpointLimits;      // clamp ranges (defaults ok)
	
END_VAR
VAR_OUTPUT
	// one-cycle command pulses for MAIN / state machine
    bCmdSesOn       	: BOOL;
    bCmdSesOff      	: BOOL;
	bCmdDeliveryOn		: BOOL;
	bCmdDeliveryOff		: BOOL;
    bCmdFaultReset  	: BOOL;
    bCmdFaultAck    	: BOOL;
    bCmdEnterMaint  	: BOOL;
    bCmdExitMaint   	: BOOL;
	bCmdExtHeaterOn		: BOOL;
	bCmdExtHeaterOff	: BOOL;
	bCmdAutofillOn		: BOOL;
	bCmdAutofillOff		: BOOL;
	bCmdDpLoopOn		: BOOL;
	bCmdDpLoopOff		: BOOL;
	bCmdTempLoopOn		: BOOL;
	bCmdTempLoopOff		: BOOL;
	bCmdApplySetpoints	: BOOL;
	
	// heartbeat supervision	
	bHmiCommLoss    : BOOL;  // feed into ST_Faults.bHmiCommLoss
END_VAR

VAR
	// heartbeat supervision
    nLastHeartbeat  : UDINT;
    tonHbTimeout    : TON;
    bFirstCycle     : BOOL := TRUE;
	
	// uptime
    tonUptime       : TON;
    nUptimeSeconds  : UDINT;
    fbTick          : TON;
END_VAR

]]></Declaration>
    <Implementation>
      <ST><![CDATA[//=========================== 1. Heartbeat supervision =========================
// Pi increments stCommand.nHmiHeartbeat every poll. If it stops changing
// for T_HMI_HEARTBEAT_TIMEOUT, declare comm loss.
IF (GVL_HMI.stHmiCommand.nHmiHeartbeat = nLastHeartbeat) AND NOT bFirstCycle THEN
	tonHbTimeout(IN := TRUE, PT := GVL_HMI.T_HMI_HEARTBEAT_TIMEOUT);
ELSE
	tonHbTimeout(IN := FALSE);
END_IF

bHmiCommLoss := tonHbTimeout.Q;
nLastHeartbeat := GVL_HMI.stHmiCommand.nHmiHeartbeat;
bFirstCycle := FALSE;

//=========================== 2. Consume command pulses ========================
// Latch each request to the output for exactly one cycle, then clear the
// GVL bit so the Pi never has to write FALSE and a stuck TRUE cannot
// repeat-fire.

// set any new commands
bCmdSesOn  			:= GVL_HMI.stHmiCommand.bSesOn; 
bCmdSesOff     		:= GVL_HMI.stHmiCommand.bSesOff;
bCmdDeliveryOn		:= GVL_HMI.stHmiCommand.bSteamDeliveryOn;
bCmdDeliveryOff		:= GVL_HMI.stHmiCommand.bSteamDeliveryOff;
bCmdFaultReset 		:= GVL_HMI.stHmiCommand.bFaultReset;
bCmdFaultAck   		:= GVL_HMI.stHmiCommand.bFaultAck;
bCmdEnterMaint 		:= GVL_HMI.stHmiCommand.bEnterMaint;
bCmdExitMaint  		:= GVL_HMI.stHmiCommand.bExitMaint;
bCmdExtHeaterOn     := GVL_HMI.stHmiCommand.bExtHeaterOn;
bCmdExtHeaterOff    := GVL_HMI.stHmiCommand.bExtHeaterOff;
bCmdAutofillOn  	:= GVL_HMI.stHmiCommand.bAutofillOn;
bCmdAutofillOff  	:= GVL_HMI.stHmiCommand.bAutofillOff;
bCmdDpLoopOn   		:= GVL_HMI.stHmiCommand.bDpControlOn;
bCmdDpLoopOff   	:= GVL_HMI.stHmiCommand.bDpControlOff;
bCmdTempLoopOn 		:= GVL_HMI.stHmiCommand.bTempControlOn;
bCmdTempLoopOff		:= GVL_HMI.stHmiCommand.bTempControlOff;
bCmdApplySetpoints	:= GVL_HMI.stHmiCommand.bApplySetpoints;

// clear stale cmds
GVL_HMI.stHmiCommand.bSesOn      		:= FALSE;
GVL_HMI.stHmiCommand.bSesOff     		:= FALSE;
GVL_HMI.stHmiCommand.bSteamDeliveryOn 	:= FALSE;
GVL_HMI.stHmiCommand.bSteamDeliveryOff 	:= FALSE;
GVL_HMI.stHmiCommand.bFaultReset 		:= FALSE;
GVL_HMI.stHmiCommand.bFaultAck   		:= FALSE;
GVL_HMI.stHmiCommand.bEnterMaint 		:= FALSE;
GVL_HMI.stHmiCommand.bExitMaint  		:= FALSE;
GVL_HMI.stHmiCommand.bExtHeaterOn   	:= FALSE;
GVL_HMI.stHmiCommand.bExtHeaterOff   	:= FALSE;
GVL_HMI.stHmiCommand.bAutofillOn 		:= FALSE;
GVL_HMI.stHmiCommand.bAutofillOff 		:= FALSE;
GVL_HMI.stHmiCommand.bDpControlOn   	:= FALSE;
GVL_HMI.stHmiCommand.bDpControlOff   	:= FALSE;
GVL_HMI.stHmiCommand.bTempControlOff 	:= FALSE;
GVL_HMI.stHmiCommand.bTempControlOn 	:= FALSE;
GVL_HMI.stHmiCommand.bApplySetpoints	:= FALSE;

// Safety interlock: ignore SES ON during comm-lost or active fault display;
// the state machine makes the final call, this is belt-and-braces.
IF bHmiCommLoss THEN
    bCmdSesOn := FALSE;
END_IF

//=========================== 5. Publish status ================================
GVL_HMI.stHmiStatus.nPlcHeartbeat     := GVL_HMI.stHmiStatus.nPlcHeartbeat + 1;
GVL_HMI.stHmiStatus.nHmiHeartbeatEcho := GVL_HMI.stHmiCommand.nHmiHeartbeat;
GVL_HMI.stHmiStatus.bHmiOnline        := NOT bHmiCommLoss;

GVL_HMI.stHmiStatus.eState       := eState;
GVL_HMI.stHmiStatus.sStateName   := TO_STRING(eState);
GVL_HMI.stHmiStatus.bReady       := bReady;

GVL_HMI.stHmiStatus.stProcess    := stProcess;
(* IF stProcess.rFlowRated > 0.0 THEN
    GVL_HMI.stStatus.rFlowPercent := 100.0 * stProcess.rFlowActual / stProcess.rFlowRated;
ELSE
    GVL_HMI.stStatus.rFlowPercent := 0.0;
END_IF

FOR i := 1 TO 6 DO
    GVL_HMI.stStatus.arPidOutput[i] := arPidOutput[i];
END_FOR

GVL_HMI.stStatus.stFaults := stFaults;
GVL_HMI.stStatus.stFaults.bHmiCommLoss := bHmiCommLoss;

// count active fault bytes (pack_mode 1: one BOOL per byte)
nFaultCount := 0;
pFaultByte := ADR(GVL_HMI.stStatus.stFaults);
FOR i := 0 TO TO_INT(SIZEOF(ST_Faults)) - 1 DO
    IF pFaultByte[i] <> 0 THEN
        nFaultCount := nFaultCount + 1;
    END_IF
END_FOR
GVL_HMI.stStatus.nActiveFaults := nFaultCount;
GVL_HMI.stStatus.bAlarmActive  := (nFaultCount > 0);

GVL_HMI.stStatus.rSetFlowApplied    := stSetpoints.rSetFlow;
GVL_HMI.stStatus.rSetDsPressApplied := stSetpoints.rSetDsPressure;
GVL_HMI.stStatus.rSetSpaTempApplied := stSetpoints.rSetSpaTemp;

GVL_HMI.stStatus.bMaintModeActive := (eState = E_SystemState.Maintenance);
FOR i := 1 TO 4 DO
    GVL_HMI.stStatus.arValveState[i] := arValveActual[i];
END_FOR
GVL_HMI.stStatus.bLoopbackOn  := bLoopbackOn;
GVL_HMI.stStatus.bDrainModeOn := bDrainMode; *)

GVL_HMI.stHmiStatus.sPlcVersion := GVL_HMI.S_PLC_VERSION;

// uptime counter (1 s self-retriggering tick)
fbTick(IN := NOT fbTick.Q, PT := T#1S);
IF fbTick.Q THEN
    nUptimeSeconds := nUptimeSeconds + 1;
END_IF
GVL_HMI.stHmiStatus.nUptimeSeconds := nUptimeSeconds;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>