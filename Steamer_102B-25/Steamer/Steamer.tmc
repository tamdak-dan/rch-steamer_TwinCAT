itOffs>1984</BitOffs></SubItem><SubItem><Name>rWaterLevel</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2016</BitOffs></SubItem><SubItem><Name>rOutputPct</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2048</BitOffs></SubItem><SubItem><Name>rDrainFactor</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2080</BitOffs><Default><Value>0.1</Value></Default></SubItem><SubItem><Name>rFillFactor</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2112</BitOffs><Default><Value>1</Value></Default></SubItem><SubItem><Name>fbSampleTick</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ --- PID sample-rate gate -----------------------------------------------]]></Comment><BitSize>224</BitSize><BitOffs>2144</BitOffs></SubItem><SubItem><Name>bSample</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>2368</BitOffs></SubItem><SubItem><Name>rDt</Name><Type>REAL</Type><Comment><![CDATA[ [s] sample interval as a real]]></Comment><BitSize>32</BitSize><BitOffs>2400</BitOffs></SubItem><SubItem><Name>rIntegral</Name><Type>REAL</Type><Comment><![CDATA[ --- per-loop PID state (index = legacy PID number) --------------------]]></Comment><BitSize>32</BitSize><BitOffs>2432</BitOffs></SubItem><SubItem><Name>rPrevPv</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2464</BitOffs></SubItem><SubItem><Name>rPrimed</Name><Type>BOOL</Type><BitSize>8</BitSize><BitOffs>2496</BitOffs></SubItem><SubItem><Name>tonPwmTimer</Name><Type Namespace="Tc2_Standard">TON</Type><Comment><![CDATA[ --- per-loop PWM state -------------------------------------------------]]></Comment><BitSize>224</BitSize><BitOffs>2528</BitOffs></SubItem><SubItem><Name>rPwmDutyLatched</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2752</BitOffs></SubItem><SubItem><Name>i</Name><Type>INT</Type><BitSize>16</BitSize><BitOffs>2784</BitOffs></SubItem><SubItem><Name>__FB_WATERFILL__RUNPID__RERROR</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2816</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPID__RPROP</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2848</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPID__RDERIV</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2880</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPID__ROUT</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>2912</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPWM__TPERIOD</Name><Type>TIME</Type><BitSize>32</BitSize><BitOffs>2944</BitOffs><Default><DateTime> no </DateTime></Default><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPWM__NPERIODMS</Name><Type>UDINT</Type><BitSize>32</BitSize><BitOffs>2976</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPWM__NONMS</Name><Type>UDINT</Type><BitSize>32</BitSize><BitOffs>3008</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><SubItem><Name>__FB_WATERFILL__RUNPWM__RDUTY</Name><Type>REAL</Type><BitSize>32</BitSize><BitOffs>3040</BitOffs><Properties><Property><Name>implicit_inst_var</Name></Property></Properties></SubItem><Method><Name>RunPid</Name><Comment><![CDATA[=============================================================================
 RunPid
-----------------------------------------------------------------------------
 Standard (ISA) positional PID, output in percent.

   out = Kp * e  +  (Kp/Ti) * INTEGRAL(e)  -  Kp * Td * d(PV)/dt

 Derivative acts on the MEASUREMENT, not the error, so a setpoint change
 does not produce a derivative spike.

 Anti-windup: the integral accumulator is clamped to the output range. This
 is the same trick as legacy rung 456 ("freeze integral if over"), which
 clamped the PID bias word to the output maximum.

 State lives in the FB's arrays, indexed by nLoop, so one method serves
 every loop. Call at the sample rate only - it uses rDt, not the task cycle.
=============================================================================]]></Comment><ReturnType>REAL</ReturnType><ReturnBitSize>32</ReturnBitSize><Parameter><Name>rSp</Name><Comment><![CDATA[ setpoint, engineering units]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rPv</Name><Comment><![CDATA[ process value, same units]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rKp</Name><Comment><![CDATA[ proportional gain [% per engineering unit]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rTi</Name><Comment><![CDATA[ integral / reset time [s]. 0 disables integral action]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rTd</Name><Comment><![CDATA[ derivative / rate time [s]. 0 disables derivative]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rOutMin</Name><Comment><![CDATA[ output floor [%]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rOutMax</Name><Comment><![CDATA[ output ceiling [%]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Parameter><Name>rDt</Name><Comment><![CDATA[ sample interval [s]]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Local><Name>rError</Name><Type>REAL</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPID__RERROR</Value></Property></Properties></Local><Local><Name>rProp</Name><Type>REAL</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPID__RPROP</Value></Property></Properties></Local><Local><Name>rDeriv</Name><Type>REAL</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPID__RDERIV</Value></Property></Properties></Local><Local><Name>rOut</Name><Type>REAL</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPID__ROUT</Value></Property></Properties></Local></Method><Method><Name>RunPwm</Name><Comment><![CDATA[=============================================================================
 RunPwm
-----------------------------------------------------------------------------
 Time-proportioned output: turns a 0..100 % demand into a digital heater
 command with a fixed period. 

 The demand is LATCHED at each period boundary. Without this the
 on-time would move underneath an in-progress pulse.

 Must be called EVERY task cycle - the period timer only advances when it
 is called. Resolution is one task cycle (10 ms), so a 2 s period gives
 0.5 % granularity.
=============================================================================]]></Comment><ReturnType>BOOL</ReturnType><ReturnBitSize>8</ReturnBitSize><Parameter><Name>rDutyPct</Name><Comment><![CDATA[ demand 0..100 %]]></Comment><Type>REAL</Type><BitSize>32</BitSize></Parameter><Local><Name>tPeriod</Name><Type>TIME</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPWM__TPERIOD</Value></Property></Properties></Local><Local><Name>nPeriodMs</Name><Type>UDINT</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPWM__NPERIODMS</Value></Property></Properties></Local><Local><Name>nOnMs</Name><Type>UDINT</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPWM__NONMS</Value></Property></Properties></Local><Local><Name>rDuty</Name><Type>REAL</Type><BitSize>32</BitSize><Properties><Property><Name>uselocation</Name><Value>__FB_WATERFILL__RUNPWM__RDUTY</Value></Property></Properties></Local></Method><Properties><Property><Name>PouType</Name><Value>FunctionBlock</Value></Property></Properties></DataType><DataType><Name>FB_OutputHandler</Name><BitSize>960</BitSize><SubItem><Name>eState</Name><Type>E_SystemState</Type><BitSize>16</BitSize><BitOffs>32</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>bWaterFillValve</Name><Type>BOOL</Type><Comment><![CDATA[ FB_WaterFill request  -> SV4]]></Comment><BitSize>8</BitSize><BitOffs>48</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>bPurgeValve</Name><Type>BOOL</Type><Comment><![CDATA[ FB_Purge request      -> SV2 during purge]]></Comment><BitSize>8</BitSize><BitOffs>56</BitOffs><Properties><Property><Name>ItemType</Name><Value>Input</Value></Property></Properties></SubItem><SubItem><Name>bDeliveryPermit</Name><Type>BOOL</Type><Comment><![CDATA[ state machin