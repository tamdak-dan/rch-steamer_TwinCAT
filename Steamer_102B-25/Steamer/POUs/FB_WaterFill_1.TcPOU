<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_WaterFill_1" Id="{a1b2c3d4-0014-4a5b-9c8d-e1f200000014}" SpecialFunc="None">
    <Declaration><![CDATA[//=============================================================================
// FB_WaterFill
//-----------------------------------------------------------------------------
// Water level control, ported from DirectSoft6 subroutines K7 / K8 / K106.
// (The EMPTY-water fault from K6 is intentionally NOT here - it lives in
//  FB_FaultMonitor, per design decision.)
//
// TWO modes selected by eMode:
//
//   StartupFill (legacy K8, state FillWater / S111):
//     - Open SV4 while the filtered CENTER switch (LS1) is dry.
//     - The instant LS1 is covered, CLOSE SV4 and run a fixed confirm dwell
//       (legacy T24 = 5 s). Valve does NOT keep filling during the dwell.
//     - When the dwell completes -> bFillComplete.
//     - If the fill-fault timer (legacy T10, preset tFillFaultTime) expires
//       while LS1 is still dry -> bWaterFillFault (legacy B1600.15 -> S10).
//
//   RunningAutofill (legacy K7, state SteamFlowing / S4):
//     - A self-contained PID holds level at the center switch (setpoint 25).
//       Its output % is time-proportioned onto the on/off solenoid over
//       tFillCycle (legacy T20 / V1516) -> metered trickle to replace boil-off.
//     - Lower-duty floor: below rFillMinDuty (legacy 10%, rung 492) the valve
//       stays shut - no meaningless sub-threshold pulsing.
//     - If the PID sits pinned at full output longer than tWaterFillCheck
//       (legacy T63 / V1555) -> bWaterRegFault (legacy B1601.0 -> S10).
//
// Switch filtering (legacy K106): raw center/empty switches debounced with
// symmetric on/off delays (tLevelFilter).
//
// Drives NO coil directly. Outputs qFillValve; FB_OutputHandler (single
// writer) maps it to GVL_IO.qxSv4Water.
//
// NOTE: references E_WaterFillMode and several GVL_SysParameters members
// that must be created. tFillConfirm is the one hard legacy constant (5 s);
// the rest map to legacy V-registers (V1543/V1503/V1516/V1555) whose values
// are pulled at commissioning. PID gains (Kp/Ki/Kd/cycle) come from the
// legacy PID4 loop table (V2240 block) - fill in during commissioning.
//=============================================================================
FUNCTION_BLOCK FB_WaterFill_1
VAR_INPUT
    eMode            : E_WaterFillMode;   // StartupFill | RunningAutofill | Idle
    bCenterSwitch    : BOOL;              // RAW LS1 center (X2). Filtered internally.
    bEmptySwitch     : BOOL;              // RAW LS3 empty  (X4). Filtered internally.
    bAutofillInhibit : BOOL;              // legacy X13 autofill-off signal
    rLevelPv         : REAL;              // level process value for the running PID (0..100)
END_VAR
VAR_OUTPUT
    qFillValve       : BOOL;              // -> FB_OutputHandler -> SV4
    bFillComplete    : BOOL;              // startup fill done (LS1 covered + dwell)
    bWaterFillFault  : BOOL;              // startup fill timeout (legacy B1600.15)
    bWaterRegFault   : BOOL;              // running reg fault    (legacy B1601.0)
    bCenterFiltered  : BOOL;              // exposed filtered LS1 (HMI / diagnostics)
    bEmptyFiltered   : BOOL;              // exposed filtered LS3
    rPidOutput       : REAL;              // running-mode PID output % (diagnostics)
END_VAR
VAR
    // ---- switch debounce (legacy K106, symmetric on/off = tLevelFilter) ----
    tonCenterOn      : TON;
    tonCenterOff     : TON;
    tonEmptyOn       : TON;
    tonEmptyOff      : TON;

    // ---- startup fill (K8) -------------------------------------------------
    tonFillFault     : TON;   // legacy T10, preset tFillFaultTime (V1503)
    tonFillDwell     : TON;   // legacy T24, fixed confirm (tFillConfirm = 5 s)

    // ---- running autofill (K7) ---------------------------------------------
    fbLevelPid       : FB_BasicPID;   // self-contained PID4 replacement
                                       // (swap for your chosen Tc2/Tc3 PID FB)
    tonRegFault      : TON;   // legacy T63, preset tWaterFillCheck (V1555)
    tonPwmWindow     : TON;   // legacy T20 time-proportioning window (V1516)
    rEffectiveDuty   : REAL;  // PID output after lower-duty floor

    ePrevMode        : E_WaterFillMode;
    bModeEntry       : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// mode-entry edge: reset per-mode timers/faults when the mode changes so a
// second entry never sees stale .Q or accumulated time.
bModeEntry := (eMode <> ePrevMode);
ePrevMode  := eMode;

//============================================================================
// 1. SWITCH DEBOUNCE  (legacy K106 - symmetric on/off delay = tLevelFilter)
//============================================================================
tonCenterOn (IN := bCenterSwitch,     PT := GVL_SysParameters.tLevelFilter);
tonCenterOff(IN := NOT bCenterSwitch, PT := GVL_SysParameters.tLevelFilter);
IF tonCenterOn.Q THEN
    bCenterFiltered := TRUE;
ELSIF tonCenterOff.Q THEN
    bCenterFiltered := FALSE;
END_IF

tonEmptyOn (IN := bEmptySwitch,     PT := GVL_SysParameters.tLevelFilter);
tonEmptyOff(IN := NOT bEmptySwitch, PT := GVL_SysParameters.tLevelFilter);
IF tonEmptyOn.Q THEN
    bEmptyFiltered := TRUE;
ELSIF tonEmptyOff.Q THEN
    bEmptyFiltered := FALSE;
END_IF

//============================================================================
// 2. MODE LOGIC
//============================================================================
CASE eMode OF

    //-- STARTUP FILL (legacy K8) ------------------------------------------
    E_WaterFillMode.StartupFill:
        IF bModeEntry THEN
            bFillComplete   := FALSE;
            bWaterFillFault := FALSE;
            tonFillDwell(IN := FALSE);
            tonFillFault(IN := FALSE);
        END_IF

        IF NOT bCenterFiltered THEN
            // --- still filling: valve open, fault timer running ---
            qFillValve := TRUE;
            tonFillFault(IN := TRUE, PT := GVL_SysParameters.tFillFaultTime);
            tonFillDwell(IN := FALSE);                 // not at level; hold dwell reset
            IF tonFillFault.Q THEN                     // legacy rung 501
                bWaterFillFault := TRUE;
            END_IF
        ELSE
            // --- LS1 covered: CLOSE valve immediately, run confirm dwell ---
            // (legacy rung 502: RST Y4 on the same rung TMR T24 starts)
            qFillValve := FALSE;
            tonFillFault(IN := FALSE);
            tonFillDwell(IN := TRUE, PT := GVL_SysParameters.tFillConfirm);
            IF tonFillDwell.Q THEN                      // legacy rung 503: done
                bFillComplete := TRUE;
            END_IF
        END_IF

    //-- RUNNING AUTOFILL (legacy K7) --------------------------------------
    E_WaterFillMode.RunningAutofill:
        IF bModeEntry THEN
            tonRegFault(IN := FALSE);
            bWaterRegFault := FALSE;
            bFillComplete  := FALSE;
        END_IF

        IF bAutofillInhibit THEN
            // legacy K6 rung 483: autofill off -> valve closed, timers reset
            qFillValve := FALSE;
            rPidOutput := 0.0;
            tonRegFault(IN := FALSE);
            tonPwmWindow(IN := FALSE);
            fbLevelPid(bEnable := FALSE);
        ELSE
            // --- run the level PID: setpoint 25 (legacy K25), PV = level ---
            fbLevelPid(
                bEnable     := TRUE,
                fSetpoint   := GVL_SysParameters.rLevelSetpoint,   // legacy K25
                fActual     := rLevelPv,
                fKp         := GVL_SysParameters.rLevelKp,
                fKi         := GVL_SysParameters.rLevelKi,
                fKd         := GVL_SysParameters.rLevelKd,
                fOut        => rPidOutput);

            // --- lower-duty floor (legacy rung 492: below 10% -> 0) ---
            IF rPidOutput < GVL_SysParameters.rFillMinDuty THEN
                rEffectiveDuty := 0.0;
            ELSE
                rEffectiveDuty := LIMIT(0.0, rPidOutput, 100.0);
            END_IF

            // --- time-proportion the duty onto the on/off solenoid ---
            // (legacy rungs 496-497: T20 window V1516, ON while TA20 < V1403)
            tonPwmWindow(IN := NOT tonPwmWindow.Q, PT := GVL_SysParameters.tFillCycle);
            qFillValve := (rEffectiveDuty > 0.0)
                          AND (tonPwmWindow.ET
                               < REAL_TO_TIME( (rEffectiveDuty / 100.0)
                                               * TIME_TO_REAL(GVL_SysParameters.tFillCycle) ));

            // --- reg fault: PID pinned at full output too long ---
            // (legacy rungs 493-495: T63 preset V1555 -> B1601.0 -> S10)
            tonRegFault(IN := (rPidOutput >= 100.0),
                        PT := GVL_SysParameters.tWaterFillCheck);
            IF tonRegFault.Q THEN
                bWaterRegFault := TRUE;
            END_IF
        END_IF

    //-- IDLE --------------------------------------------------------------
    ELSE
        qFillValve := FALSE;
        rPidOutput := 0.0;
        tonFillFault(IN := FALSE);
        tonFillDwell(IN := FALSE);
        tonRegFault(IN := FALSE);
        tonPwmWindow(IN := FALSE);
        fbLevelPid(bEnable := FALSE);
END_CASE
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>