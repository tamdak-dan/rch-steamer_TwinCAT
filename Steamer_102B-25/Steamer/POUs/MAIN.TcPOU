<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{f6813ce8-0276-401c-9fea-66add7e7619a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// HMI Variables
	HMI_bRun 	: BOOL;
	HMI_nPT1	: INT;
	
	// state machine
	eSystemState		: E_SystemState;

	// function blocks
	fbInputScaling		: FB_InputScaling;
	fbFaultMonitor 		: FB_FaultMonitor;
	fbHmi 				: FB_Hmi;
	fbPressureControl 	: FB_PressureControl;
	fbPurge 			: FB_Purge;
	fbSpaFlush			: FB_SpaFlush;
	fbStateMachine 		: FB_StateMachine;
	fbWaterFill 		: FB_WaterFill;
	fbOutputHandler		: FB_OutputHandler;
	
	// fbWaterFill
	reqSV4_FillVavle			: BOOL;
	bLS1_WaterCenter_Filtered	: BOOL;
	bLS3_WaterEmpty_Filtered	: BOOL;
	
	// fbPurge
	reqSV1_DrainValve			: BOOL;
	
	// fbPresureControl
	reqH1_Upstream				: BOOL;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//========================= FB CALLS =====================================

// SCALE INPUTS
fbInputScaling();

// FAULT CHECK
fbFaultMonitor();

//========================= HMI (publish + consume) =======================
// Run BEFORE the state machine so command pulses are latched this cycle.
// FB_Hmi publishes GVL_HMI.stStatus and clears consumed command bits.
(* fbHmi(eState        := fbStateMachine.eState,
      stProcess     := GVL_Process.stValues,
      stFaults      := fbFaultMonitor.stFaults,
      bReady        := fbStateMachine.bReady,
      arPidOutput   := fbPressureControl.arOutputPct,
      arValveActual := fbOutputs.arValveState,
      stLimits      := stSetpointLimits); *)
	  
//========================= STATE MACHINE =================================
// Consume the one-cycle HMI command pulses, then run the CASE.
IF fbHmi.bCmdSesOn THEN fbStateMachine.RequestStart(); END_IF
IF fbHmi.bCmdSesOff THEN fbStateMachine.RequestStop(); END_IF
IF fbHmi.bCmdEnterMaint THEN fbStateMachine.RequestMaintenance(); END_IF
IF fbHmi.bCmdExitMaint THEN fbStateMachine.RequestExitMaint(); END_IF
IF fbHmi.bCmdFaultReset THEN
    //fbFaultMonitor.ResetAll();
    fbStateMachine.RequestFaultReset();
END_IF;

// Latch fault -> force state machine into Fault (only auto-clears via reset).
(* IF fbFaultMonitor.bAnyLatchingFault THEN
    fbStateMachine.RequestFault();
END_IF *)

fbStateMachine(
	stFaults := GVL_HMI.stHmiStatus.stFaults,
	stHmiSetpoints := GVL_HMI.stHmiSetpoints,
	stProcessValues := fbInputScaling.stProcessValues,
	bDeliveryCmd := fbHmi.bCmdDelivery,
	bFillComplete := fbWaterFill.bFillComplete,
	bPurgeComplete := fbPurge.bPurgeComplete,
	rSpaTemp := fbInputScaling.stProcessValues.rTc1Spa,
	bSpaFlushed := fbSpaFlush.bSpaFlushed,
	eState => eSystemState
);
				
//========================= SUBROUTINES =================================
// Subroutines only run only when the state machine enables them. In Maintenance,
// the enable flags follow the HMI control-loop override toggles.

fbWaterFill(
	eMode := fbStateMachine.eWaterFillMode,
	bCenterSwitch := GVL_IO.biLS1_WaterMidLevel,
	bEmptySwitch := GVL_IO.biLS3_WaterEmpty,
	bAutofillEnable := GVL_HMI.stHmiCommand.bAutofillEnable,
	bFillComplete => GVL_HMI.stHmiStatus.bFillComplete,
	bWaterFillFault => GVL_HMI.stHmiStatus.stFaults.bWaterFill,
	bCenterFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterFull,
	bEmptyFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterEmpty
);

fbPurge(
	bEnable :=fbStateMachine.bPurgeEnable,
	rUpstreamPress := fbInputScaling.stProcessValues.rPt1Upstream,
	bEmptyFiltered := fbWaterFill.bEmptyFiltered,
	bPurgeTimeout => GVL_HMI.stHmiStatus.stFaults.bVesselPurge
);
		
fbPressureControl(
	bEnable := fbStateMachine.bControlEnable,          
	eState := fbStateMachine.eState,        
	bDpControlOff := GVL_HMI.stHmiCommand.bDpControlOff,
	bTempControlOff := GVL_HMI.stHmiCommand.bTempControlOff,
	bExtHeaterEnable := GVL_HMI.stHmiCommand.bExtHeaterEnable,
	stProcess := fbInputScaling.stProcessValues,
	stSetpoints := GVL_HMI.stHmiSetpoints 
);

fbSpaFlush(
	bEnable := fbStateMachine.bSpaFlushEnable,
	bReset := fbStateMachine.bSpaFlushReset,
	rUpstreamPress := fbInputScaling.stProcessValues.rPt1Upstream,
	rAtmPressure := fbInputScaling.stProcessValues.rAtmPressure);
	




//========================= OUTPUT HANDLER ====================================
fbOutputHandler(
	eState := fbStateMachine.eState,
	bWaterFillValve := fbWaterFill.qFillValve,
	bPurgeValve := fbPurge.qDrainValve,
	bDeliveryPermit := ,
	bH1Upstream := fbPressureControl.qH1_UpstreamHeater,
	bH2Purifier := fbPressureControl.qH2_SpaHeater,
	bFmHeater := fbPressureControl.qH3_FlowmeterHeater,
	bExtHeater := fbPressureControl.qH4_ExternalHeater,
	arValveOverride := GVL_HMI.stHmiCommand.aValveCmd,
	stProcess := fbInputScaling.stProcessValues
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>