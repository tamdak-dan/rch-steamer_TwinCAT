<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.19">
  <POU Name="MAIN" Id="{f6813ce8-0276-401c-9fea-66add7e7619a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	// HMI Variables
	HMI_bRun 	: BOOL;
	HMI_nPT1	: INT;
	
	// state machine
	eSystemState		: E_SystemState;

	// function blocks
	fbProcessCalcs		: FB_ProcessCalcs;
	fbFaultMonitor 		: FB_FaultMonitor;
	fbHmi 				: FB_Hmi;
	fbPressureControl 	: FB_PressureControl;
	fbPurge 			: FB_Purge;
	fbSpaFlush			: FB_SpaFlush;
	fbStateMachine 		: FB_StateMachine;
	fbWaterFill 		: FB_WaterFill;
	fbOutputHandler		: FB_OutputHandler;
	
	// fbWaterFill
	reqSV4_FillVavle			: BOOL;
	bLS1_WaterCenter_Filtered	: BOOL;
	bLS3_WaterEmpty_Filtered	: BOOL;
	
	// fbPurge
	reqSV1_DrainValve			: BOOL;
	
	// fbPresureControl
	reqH1_Upstream				: BOOL;
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//========================= FB CALLS =====================================

// SCALE INPUTS
fbProcessCalcs(eState := fbStateMachine.eState);

// FAULT CHECK
fbFaultMonitor(
	stProcess := fbProcessCalcs.stProcessValues,
	eState := fbStateMachine.eState,
	bPurgeActive := fbStateMachine.bPurgeEnable,
	bWaterFillActive := (fbWaterFill.eMode = E_WaterFillMode.RunningAutofill) 
						 OR (fbWaterFill.eMode = E_WaterFillMode.StartupFill),
	bDiffPressActive := fbStateMachine.bControlEnable,
	bDiffPressReached := fbPressureControl.bDiffPressReached,
	bTempControlActive := fbStateMachine.bControlEnable,
	bColdStart := fbStateMachine.bColdStart,
	bReadyReached := fbStateMachine.bReady,
	bSteamFlowing := fbStateMachine.bDeliveryEnable,
	bWaterEmptyFiltered := fbWaterFill.bEmptyFiltered,
	bWaterCenterFiltered := fbWaterFill.bCenterFiltered,
	bExternalHeaterOff := NOT fbStateMachine.bExtHeaterEnable,
	bHmiHeartbeatOk := NOT fbHmi.bHmiCommLoss
	);
	
// Latch fault -> force state machine into Fault (only auto-clears via reset).
IF fbFaultMonitor.bAnyLatchingFault THEN
    fbStateMachine.RequestFault();
END_IF

//========================= HMI (publish + consume) =======================
// Run BEFORE the state machine so command pulses are latched this cycle.
// FB_Hmi publishes GVL_HMI.stStatus and clears consumed command bits.
fbHmi(
	eState      				:= fbStateMachine.eState,
    stProcess   				:= fbProcessCalcs.stProcessValues,
	stFaults					:= fbFaultMonitor.stFaults,
	bReady 						:= fbStateMachine.bReady
);
	  
// Consume the one-cycle HMI command pulses
IF fbHmi.bCmdSesOn THEN fbStateMachine.RequestStart(); END_IF
IF fbHmi.bCmdSesOff THEN fbStateMachine.RequestStop(); END_IF
IF fbHmi.bCmdDeliveryOn THEN fbStateMachine.RequestDelivery(TRUE); END_IF
IF fbHmi.bCmdDeliveryOff THEN fbStateMachine.RequestDelivery(FALSE); END_IF
IF fbHmi.bCmdFaultReset THEN fbFaultMonitor.ResetAll(); fbStateMachine.RequestFaultReset(); END_IF;
// IF fbHmi.bCmdFaultAck THEN ...
IF fbHmi.bCmdEnterMaint THEN fbStateMachine.RequestMaintenance(); END_IF
IF fbHmi.bCmdExitMaint THEN fbStateMachine.RequestExitMaint(); END_IF
IF fbHmi.bCmdExtHeaterOn THEN fbStateMachine.RequestExtHeater(TRUE); END_IF
IF fbHmi.bCmdExtHeaterOff THEN fbStateMachine.RequestExtHeater(FALSE); END_IF
IF fbHmi.bCmdAutofillOn THEN fbStateMachine.RequestAutofill(TRUE); END_IF
IF fbHmi.bCmdAutofillOff THEN fbStateMachine.RequestAutofill(FALSE); END_IF
IF fbHmi.bCmdDpLoopOn THEN fbStateMachine.RequestDpLoop(TRUE); END_IF
IF fbHmi.bCmdDpLoopOff THEN fbStateMachine.RequestDpLoop(FALSE); END_IF
IF fbHmi.bCmdTempLoopOn THEN fbStateMachine.RequestTempLoop(TRUE); END_IF
IF fbHmi.bCmdTempLoopOff THEN fbStateMachine.RequestTempLoop(FALSE); END_IF
IF fbHmi.bCmdApplySetpoints THEN
	IF GVL_HMI.stHmiSetpoints.rSetDsPressure < GVL_SysParameters.rP3AbsMin THEN GVL_HMI.stHmiSetpoints.rSetDsPressure := GVL_SysParameters.rP3AbsMin; END_IF
	IF GVL_HMI.stHmiSetpoints.rSetDsPressure > GVL_SysParameters.rP3AbsMax THEN GVL_HMI.stHmiSetpoints.rSetDsPressure := GVL_SysParameters.rP3AbsMax; END_IF
	IF GVL_HMI.stHmiSetpoints.rSetFlow < GVL_SysParameters.rFlowMin THEN GVL_HMI.stHmiSetpoints.rSetFlow := GVL_SysParameters.rFlowMin; END_IF
	IF GVL_HMI.stHmiSetpoints.rSetFlow > GVL_SysParameters.rFlowMax THEN GVL_HMI.stHmiSetpoints.rSetFlow := GVL_SysParameters.rFlowMax; END_IF
END_IF

//========================= STATE MACHINE =================================

fbStateMachine(
	stFaults := fbFaultMonitor.stFaults,
	stHmiSetpoints := GVL_HMI.stHmiSetpoints,
	stProcessValues := fbProcessCalcs.stProcessValues,
	bFillComplete := fbWaterFill.bFillComplete,
	bPurgeComplete := fbPurge.bPurgeComplete,
	bSpaFlushed := fbSpaFlush.bSpaFlushed,
	bDpReached := fbPressureControl.bDiffPressReached,
	eState => eSystemState
);
				
//========================= SUBROUTINES =================================
// Subroutines only run only when the state machine enables them. In Maintenance,
// the enable flags follow the HMI control-loop override toggles.

fbWaterFill(
	eMode := fbStateMachine.eWaterFillMode,
	bCenterSwitch := GVL_IO.biLS1_WaterMidLevel,
	bEmptySwitch := GVL_IO.biLS3_WaterLowLevel,
	bAutofillEnable := fbStateMachine.bAutofillEnable,
	bFillComplete => GVL_HMI.stHmiStatus.bFillComplete,
	bCenterFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterFull,
	bEmptyFiltered => GVL_HMI.stHmiStatus.stProcess.bWaterEmpty
);

fbPurge(
	bEnable :=fbStateMachine.bPurgeEnable,
	rUpstreamPress := fbProcessCalcs.stProcessValues.rPt1Upstream,
	bEmptyFiltered := fbWaterFill.bEmptyFiltered,
	bPurgeTimeout => GVL_HMI.stHmiStatus.stFaults.bPurgeTimeout
);
		

fbSpaFlush(
	bEnable := fbStateMachine.bSpaFlushEnable,
	bReset := fbStateMachine.bSpaFlushReset,
	rUpstreamPress := fbProcessCalcs.stProcessValues.rPt1Upstream,
	rAtmPressure := fbProcessCalcs.stProcessValues.rAtmPressure
);
	
fbPressureControl(
	bEnable := fbStateMachine.bControlEnable,          
	eState := fbStateMachine.eState,        
	bDpControlOff := NOT fbStateMachine.bDpLoopEnable,
	bTempControlOff := NOT fbStateMachine.bTempLoopEnable,
	bExtHeaterEnable := fbStateMachine.bExtHeaterEnable,
	stProcess := fbProcessCalcs.stProcessValues,
	stSetpoints := GVL_HMI.stHmiSetpoints ,
	bFlushed := fbSpaFlush.bSpaFlushed,
	bSpaPressurized := fbSpaFlush.bSpaPressurized
);



//========================= OUTPUT HANDLER ====================================
fbOutputHandler(
	eState := fbStateMachine.eState,
	bWaterFillValve := fbWaterFill.qFillValve,
	bPurgeValve := fbPurge.qDrainValve,
	bDeliveryPermit := fbStateMachine.bDeliveryEnable,
	bH1Upstream := fbPressureControl.qH1_UpstreamHeater,
	bH2Purifier := fbPressureControl.qH2_SpaHeater,
	bFmHeater := fbPressureControl.qH3_FlowmeterHeater,
	bExtHeater := fbPressureControl.qH4_ExternalHeater,
	arValveOverride := GVL_HMI.stHmiCommand.aValveCmd,
	stProcess := fbProcessCalcs.stProcessValues
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>